DATABASE_URL=postgresql+psycopg://queuemanager:queuemanager@postgres:5432/queuemanager
APP_URL=http://localhost:8000
SECRET_KEY=change-me-in-production
SECURE_COOKIES=false
SESSION_MAX_AGE_SECONDS=2592000
LEGAL_OPERATOR_NAME=ИП или название вашей организации
LEGAL_CONTACT_EMAIL=privacy@example.com
AUTO_CREATE_TABLES=false
LLM_API_KEY=
# Model Studio requires the workspace-specific OpenAI-compatible base URL.
# Example: https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_SECONDS=30
# Local fallback. Install/pull with: ollama pull qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
