# Public address. Do not add a trailing slash.
DOMAIN=queuemanager.duckdns.org

# Generate both values independently with: openssl rand -hex 32
POSTGRES_DB=queuemanager
POSTGRES_USER=queuemanager
POSTGRES_PASSWORD=replace_with_random_hex
SECRET_KEY=replace_with_another_random_hex

SECURE_COOKIES=true
SESSION_MAX_AGE_SECONDS=2592000
LEGAL_OPERATOR_NAME=Администрация QueueManager
LEGAL_CONTACT_EMAIL=privacy@example.com

# Ollama is included in the production Compose stack.
OLLAMA_MODEL=qwen3:8b
QWEN_TIMEOUT_SECONDS=60

# Optional cloud Qwen alternative. Leave both empty to use Ollama.
LLM_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus
